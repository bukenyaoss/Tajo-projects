<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TAJO WORLD - Join The Game</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; font-family: Arial, sans-serif; }
body { background:#0f0f1a; color:white; padding:20px; text-align:center; }
.top { background:#ff4757; color:white; padding:10px; border-radius:10px; font-weight:bold; margin-bottom:15px; }
h1 { font-size:32px; margin:10px 0; }
h1 span { color:#00ff88; }
.subtitle { color:#aaa; margin-bottom:20px; }
.card { background:#1e1e2e; border:1px solid #333; border-radius:20px; padding:25px; max-width:450px; margin:0 auto 20px auto; text-align:left; }
.card h2 { font-size:22px; margin-bottom:5px; }
.card p { color:#ccc; margin:8px 0; font-size:15px; }
.big-green { color:#00ff88; font-weight:bold; font-size:26px; }
.big-white { font-weight:bold; font-size:26px; }
.progress-bar { background:#333; height:12px; border-radius:10px; overflow:hidden; margin:12px 0; }
.progress-fill { background:#00ff88; height:100%; width:0%; }
.stats { display:flex; justify-content:space-between; background:#2a2a3a; padding:12px; border-radius:10px; margin:12px 0; text-align:center; }
.stats div b { display:block; font-size:20px; }
.stats div span { font-size:12px; color:#aaa; }
.group-card { background:#2a2a3a; border:2px solid #00ff88; border-radius:15px; padding:18px; margin-top:15px; }
.group-card h3 { color:#00ff88; margin-bottom:8px; }
.group-name { color:#FFD700; font-weight:bold; font-size:18px; margin:5px 0; }
.my-group { border:2px solid #FFD700 !important; background:#3a2a00 !important; }
.all-groups { background:#2a2a3a; border-radius:12px; padding:12px; margin-top:15px; text-align:left; max-height:300px; overflow-y:auto; }
.all-groups h4 { color:white; margin-bottom:10px; }
.group-row { display:flex; justify-content:space-between; padding:8px; border-bottom:1px solid #444; font-size:14px; }
.group-row.my { background:#FFD700; color:#000; font-weight:bold; border-radius:8px; }
.join-btn { background:#00ff88; color:#000; border:none; width:100%; padding:15px; border-radius:12px; font-size:18px; font-weight:bold; cursor:pointer; margin-top:15px; }
.join-btn:active { transform:scale(0.98); }
.join-btn:disabled { background:#555; color:#999; }
.urgent { background:#fff3cd; color:#000; padding:10px; border-radius:10px; margin-top:15px; font-weight:bold; font-size:14px; text-align:center; }
#msg { text-align:center; color:#00ff88; font-weight:bold; margin-top:10px; }
.games { display:grid; grid-template-columns:1fr 1fr; gap:12px; max-width:450px; margin:0 auto; }
.game { background:#1e1e2e; padding:18px; border-radius:15px; }
.game span { font-size:30px; }
.footer { color:#666; font-size:12px; margin-top:25px; }
</style>
</head>
<body>

<div class="top">🔥 LIVE NOW - <span id="totalJoinedTop">0</span> People Already Joined!</div>

<h1>🌍 TAJO <span>WORLD</span></h1>
<p class="subtitle">The Biggest Games Community in Uganda<br>Truth or Dare • Would You Rather • Riddles & More</p>

<div class="card">
<h2>🎮 Join TAJO WORLD Games</h2>
<p>Be part of the fastest growing games community.</p>

<p><span class="big-green" id="freeGroupsTop">50</span> <b>Groups Left FREE</b></p>
<div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
<p><span id="percentText">0%</span> Full - <span id="freeGroupsText">50</span> still FREE!</p>

<div class="stats">
<div><b id="totalGroups">50</b><span>Total</span></div>
<div><b id="occupiedGroups">0</b><span>Occupied</span></div>
<div><b id="freeGroups">50</b><span>Free</span></div>
</div>

<!-- GROUP 1 - YOUR GROUP - NEVER DISAPPEARS -->
<div class="group-card my-group">
<h3>⭐ GROUP 1 - YOUR GROUP 👑</h3>
<p class="group-name">Name: TAJO WORLD 1</p>
<p>Every group has <b>16 members</b> - same for all groups, constant.</p>
<p><span class="big-white" id="spotsLeft">16</span> <b>Spots Left in Group 1</b></p>
<p><span id="joinedCount">0</span> member joined • <span id="leftCount">16</span> empty chairs left out of 16</p>
<p id="group1Status" style="color:#FFD700; font-weight:bold;">🟢 OPEN - Join Now</p>
</div>

<!-- ALL GROUPS - ALL STAY FOREVER -->
<div class="all-groups">
<h4>📋 ALL GROUPS - They Never Disappear:</h4>
<div id="allGroupsList"></div>
</div>

<button class="join-btn" id="joinBtn" onclick="joinGroup()">JOIN GROUP 1 NOW 🚀</button>
<p id="msg"></p>

<div class="urgent">⚡ Hurry! Only <span id="urgentSpots">16</span> spots left in Group 1.</div>
</div>

<div class="games">
<div class="game"><span>😈</span><br><b>Truth or Dare</b><br><small>Play Now</small></div>
<div class="game"><span>🤔</span><br><b>Would You Rather</b><br><small>Play Now</small></div>
<div class="game"><span>🧩</span><br><b>Riddles</b><br><small>Play Now</small></div>
<div class="game"><span>🎲</span><br><b>Lucky Games</b><br><small>Play Now</small></div>
</div>

<p class="footer">© 2026 TAJO WORLD • Made in Uganda 🇺🇬<br>Total Capacity: 50 Groups × 16 Members = 800 Players</p>

<script>
const TOTAL_GROUPS = 50;
const GROUP_SIZE = 16;
let groups = [];
for(let i=1; i<=TOTAL_GROUPS; i++){
  groups.push({ number:i, name:'TAJO WORLD '+i, count:0, full:false });
}
let totalJoined = 0;

function renderAllGroups(){
  let html = '';
  groups.forEach(g=>{
    let status = g.full ? '🔒 FULL 16/16' : '🟢 OPEN ' + g.count + '/16';
    let extra = g.number===1 ? ' my' : '';
    let label = g.number===1 ? ' 👑 YOUR GROUP' : '';
    html += '<div class="group-row'+extra+'"><span>Group '+g.number+' - '+g.name+label+'</span><span>'+status+'</span></div>';
  });
  document.getElementById('allGroupsList').innerHTML = html;
}

function updateDisplay(){
  let occupied = groups.filter(g=>g.full).length;
  let freeGroups = TOTAL_GROUPS - occupied;
  let g1 = groups[0];
  let spotsLeft = GROUP_SIZE - g1.count;
  document.getElementById('freeGroupsTop').innerText = freeGroups;
  document.getElementById('freeGroups').innerText = freeGroups;
  document.getElementById('freeGroupsText').innerText = freeGroups;
  document.getElementById('occupiedGroups').innerText = occupied;
  document.getElementById('spotsLeft').innerText = spotsLeft;
  document.getElementById('joinedCount').innerText = g1.count;
  document.getElementById('leftCount').innerText = spotsLeft;
  document.getElementById('urgentSpots').innerText = spotsLeft;
  document.getElementById('totalJoinedTop').innerText = totalJoined;
  document.getElementById('group1Status').innerText = g1.full ? '🔒 OCCUPIED - 16/16 FULL - But Name Still Shows' : '🟢 OPEN - Join Now';
  let percent = Math.round((occupied / TOTAL_GROUPS) * 100);
  document.getElementById('percentText').innerText = percent + '%';
  document.getElementById('progressFill').style.width = percent + '%';
  renderAllGroups();
}

function joinGroup(){
  let g1 = groups[0];
  if(g1.count < GROUP_SIZE){
    g1.count++;
    totalJoined++;
    if(g1.count === GROUP_SIZE){
      g1.full = true;
      document.getElementById('msg').innerText = 'Group 1 is now FULL! But it STAYS here for all to see. Name: TAJO WORLD 1';
    } else {
      document.getElementById('msg').innerText = 'Welcome! You joined Group 1. ' + (GROUP_SIZE - g1.count) + ' spots left!';
    }
    updateDisplay();
  } else {
    document.getElementById('msg').innerText = 'Group 1 is FULL (16/16) - Name still shows: TAJO WORLD 1';
  }
}
updateDisplay();
</script>
</body>
</html>